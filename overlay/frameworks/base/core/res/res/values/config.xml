<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Whether device has physical keys -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- If this is true, the screen will come on when you unplug usb/power/whatever. -->
    <bool name="config_unplugTurnsOnScreen">true</bool>

    <!-- USB Configuration -->
    <bool name="config_hasUsbPort">false</bool>

    <!-- IMS & VoLTE Configuration -->
    <bool name="config_device_volte_available">true</bool>
    <bool name="config_device_vt_available">true</bool>
    <bool name="config_device_wfc_available">true</bool>
    <bool name="config_carrier_volte_available">true</bool>
    <bool name="config_carrier_volte_tty_supported">true</bool>
    <bool name="config_dynamic_bind_ims">true</bool>
    <string name="config_ims_package_override">com.mediatek.ims</string>

    <!-- Network & Fused Location Provider Configuration (microG / UnifiedNlp / GMS) -->
    <string-array name="config_locationProviderPackageNames" translatable="false">
        <item>com.google.android.gms</item>
        <item>com.android.location.fused</item>
        <item>org.microg.nlp</item>
    </string-array>

    <string-array name="config_locationExtraPackageNames" translatable="false">
        <item>com.google.android.gms</item>
        <item>org.microg.nlp</item>
    </string-array>

    <bool name="config_enableNetworkLocationOverlay" translatable="false">true</bool>
    <bool name="config_enableFusedLocationOverlay" translatable="false">true</bool>

    <!-- Biometric Sensors: ID 0, Modality 2 (Fingerprint), Strength 15 (Strong) -->
    <string-array name="config_biometric_sensors" translatable="false">
        <item>0:2:15</item>
    </string-array>

    <!-- Side-mounted power button fingerprint sensor -->
    <bool name="config_is_powerbutton_fps" translatable="false">true</bool>
</resources>
