cc_library {
    name: "libshim_camera_metadata",
    shared_libs: ["libcamera_metadata"],
    srcs: ["libshim_camera_metadata.cpp"],
    vendor: true
}

cc_library_shared {
    name: "libshim_sink",
    srcs: ["libshim_sink.cpp"],
    compile_multilib: "both",
    shared_libs: [
        "libaudioclient",
        "libdl",
    ],
    header_libs: [
        "libaudioclient_headers",
        "libmedia_headers",
        "libmediametrics_headers",
    ],
}

cc_library_shared {
    name: "libstagefright_hdcp",
    srcs: ["libstagefright_hdcp.cpp"],
    compile_multilib: "32",
    header_libs: [
        "libhardware_headers",
        "libmedia_headers",
    ],
    shared_libs: [
        "liblog",
        "libutils",
    ],
}


