# Keymaster & TEE
/(vendor|system/vendor)/bin/hw/android\.hardware\.keymaster@4\.0-service\.beanpod  u:object_r:hal_keymaster_default_exec:s0
/(system/vendor|vendor)/bin/hw/vendor\.mediatek\.hardware\.keymaster_attestation@1\.1-service u:object_r:hal_keymaster_default_exec:s0
/(vendor|system/vendor)/bin/teei_daemon u:object_r:tee_exec:s0
/(vendor|system/vendor)/bin/teei_loader u:object_r:tee_exec:s0
/data/vendor/thh(/.*)?                  u:object_r:tee_data_file:s0
/dev/ut_keymaster                       u:object_r:tee_device:s0
/dev/rpmb0                              u:object_r:tee_device:s0
/dev/emmcrpmb0                          u:object_r:tee_device:s0
/dev/tz_vfs                             u:object_r:tee_device:s0
/dev/teei_fp                            u:object_r:tee_device:s0
/dev/isee_tee0                          u:object_r:tee_device:s0
/dev/teei_config                        u:object_r:tee_device:s0
/dev/teei_client                        u:object_r:tee_device:s0
/dev/utr_tui                            u:object_r:tee_device:s0
/mnt/vendor/persist(/.*)?               u:object_r:tee_data_file:s0

