type proc_ged, fs_type, proc_type;

allow { domain -coredomain -isolated_app } proc_ged:file rw_file_perms;
allowxperm { domain -coredomain -isolated_app } proc_ged:file ioctl { 0x6700-0x67ff };

allow appdomain proc_ged:file rw_file_perms;
allowxperm appdomain proc_ged:file ioctl { 0x6700-0x67ff };

allow hal_graphics_composer_default proc_ged:file rw_file_perms;
allowxperm hal_graphics_composer_default proc_ged:file ioctl { 0x6700-0x67ff };

allow hal_graphics_allocator_default proc_ged:file rw_file_perms;
allowxperm hal_graphics_allocator_default proc_ged:file ioctl { 0x6700-0x67ff };

