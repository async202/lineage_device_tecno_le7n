allow nfc custom_file:dir getattr;
allow nfc gas_srv_service:service_manager find;
allow nfc media_rw_data_file:dir { add_name create open read remove_name search write };
allow nfc media_rw_data_file:file { create open read rename unlink write };
allow nfc nfc_data_file:dir { add_name create remove_name search setattr write };
allow nfc nfc_data_file:file { create getattr ioctl open read rename setattr unlink write };
allow nfc nfc_socket:dir { add_name remove_name search write };
allow nfc nfc_socket:sock_file { create setattr unlink write };
allow nfc node:tcp_socket node_bind;
allow nfc port:tcp_socket name_bind;
allow nfc sdcard_type:dir { add_name create remove_name search write };
allow nfc sdcard_type:file { create getattr open read rename write };
allow nfc self:tcp_socket { accept bind connect create getattr getopt listen read setopt write };
allow nfc st21nfc_device:chr_file { getattr ioctl open read write };
allow nfc surfaceflinger:dir search;
allow nfc surfaceflinger:fifo_file { read write };
allow nfc sw_sync_device:chr_file getattr;
allow nfc vfat:dir { add_name search write };
allow nfc vfat:file { create getattr open read write };
allow nfc zygote:unix_stream_socket { getattr getopt };
