type osi, coredomain, domain;
type osi_exec, exec_type, file_type, system_file_type;

binder_call(osi, system_server)

binder_use(osi)

domain_auto_trans(osi, netutils_wrapper_exec, netutils_wrapper)

init_daemon_domain(osi)

net_domain(osi)

set_prop(osi, system_prop)

unix_socket_connect(osi, property, radio)
unix_socket_connect(osi, property, system_app)

allow osi fs_bpf:dir search;
allow osi fs_bpf:file read;
allow osi fuse:dir create_dir_perms;
allow osi fuse:{ file lnk_file } create_file_perms;
allow osi kernel:system module_request;
allow osi media_rw_data_file:dir create_dir_perms;
allow osi media_rw_data_file:{ file lnk_file } create_file_perms;
allow osi mnt_user_file:dir create_dir_perms;
allow osi mnt_user_file:{ file lnk_file } create_file_perms;
allow osi osi:fifo_file rw_file_perms;
allow osi osi_data_file:dir create_dir_perms;
allow osi osi_data_file:dir ioctl;
allow osi osi_data_file:file create_file_perms;
allow osi package_service:service_manager find;
allow osi postinstall_file:dir create_dir_perms;
allow osi postinstall_file:file x_file_perms;
allow osi postinstall_file:filesystem { mount relabelfrom relabelto unmount };
allow osi postinstall_file:{ file lnk_file } create_file_perms;
allow osi postinstall_mnt_dir:dir { create_dir_perms mounton };
allow osi proc:dir r_dir_perms;
allow osi proc_net:dir r_dir_perms;
allow osi proc_net:file r_file_perms;
allow osi proc_qtaguid_stat:dir r_dir_perms;
allow osi proc_qtaguid_stat:file r_file_perms;
allow osi rootfs:lnk_file r_file_perms;
allow osi sdcardfs:dir create_dir_perms;
allow osi sdcardfs:filesystem { mount relabelfrom unmount };
allow osi sdcardfs:{ file lnk_file } create_file_perms;
allow osi self:capability { chown fsetid net_admin net_raw sys_admin };
allow osi self:capability sys_module;
allow osi self:netlink_route_socket { nlmsg_read nlmsg_write };
allow osi self:{ packet_socket unpriv_socket_class_set } create_stream_socket_perms;
allow osi shell_exec:file rx_file_perms;
allow osi storage_file:dir create_dir_perms;
allow osi storage_file:{ file lnk_file } create_file_perms;
allow osi sysfs:dir r_dir_perms;
allow osi sysfs_net:dir r_dir_perms;
allow osi sysfs_net:file r_file_perms;
allow osi system_file:file rx_file_perms;
allow osi tmpfs:dir create_dir_perms;
allow osi tmpfs:{ file lnk_file } create_file_perms;
allow osi toolbox_exec:file rx_file_perms;
allow osi vendor_file:dir read;

