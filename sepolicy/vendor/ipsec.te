type ipsec, domain;
type ipsec_exec, exec_type, file_type, vendor_file_type;

net_domain(ipsec)

set_prop(ipsec, vendor_mtk_wod_prop)

unix_socket_connect(ipsec, dnsproxyd, init)
unix_socket_connect(ipsec, dnsproxyd, netd)
unix_socket_connect(ipsec, fwmarkd, init)
unix_socket_connect(ipsec, fwmarkd, netd)
unix_socket_connect(ipsec, netd, init)
unix_socket_connect(ipsec, netd, netd)
unix_socket_connect(ipsec, property, netd)

allow ipsec charon_exec:file execute_no_trans;
allow ipsec custom_file:dir { open read search };
allow ipsec custom_file:file { getattr open read };
allow ipsec devpts:chr_file { open read write };
allow ipsec epdg_wod:fd use;
allow ipsec epdg_wod:unix_stream_socket { connectto read write };
allow ipsec node:udp_socket node_bind;
allow ipsec port:tcp_socket name_connect;
allow ipsec port:udp_socket name_bind;
allow ipsec proc_modules:file getattr;
allow ipsec proc_net:file getattr;
allow ipsec proc_net:file write;
allow ipsec self:capability { kill net_admin net_bind_service };
allow ipsec self:capability2 wake_alarm;
allow ipsec self:tcp_socket { connect create getattr getopt read write };
allow ipsec self:udp_socket { bind create read setopt write };
allow ipsec self:{ netlink_route_socket netlink_xfrm_socket } { bind create nlmsg_read nlmsg_write read write };
allow ipsec vendor_configs_file:file ioctl;
allow ipsec wod_apn_conf_file:dir { add_name create open read remove_name search write };
allow ipsec wod_apn_conf_file:file { getattr ioctl open read write };
allow ipsec wod_ipsec_conf_file:dir { add_name open read remove_name search write };
allow ipsec wod_ipsec_conf_file:file { append create getattr ioctl open read unlink write };
allow ipsec wod_ipsec_conf_file:sock_file { create setattr unlink write };
