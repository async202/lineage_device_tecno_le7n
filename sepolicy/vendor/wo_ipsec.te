type wo_ipsec, domain;
type wo_ipsec_exec, exec_type, file_type, vendor_file_type;

domain_auto_trans(wo_ipsec, netutils_wrapper_exec, netutils_wrapper)

net_domain(wo_ipsec)

unix_socket_connect(wo_ipsec, dnsproxyd, netd)
unix_socket_connect(wo_ipsec, fwmarkd, netd)
unix_socket_connect(wo_ipsec, netd, netd)
unix_socket_connect(wo_ipsec, wo_epdg_ipsec, netd)

allow wo_ipsec custom_file:dir { open read search };
allow wo_ipsec custom_file:file { getattr open read };
allow wo_ipsec devpts:chr_file { open read write };
allow wo_ipsec epdg_apn_conf_file:dir { add_name create open read remove_name search write };
allow wo_ipsec epdg_apn_conf_file:file { getattr ioctl open read write };
allow wo_ipsec epdg_ipsec_conf_file:dir { add_name open read remove_name search write };
allow wo_ipsec epdg_ipsec_conf_file:file { append create getattr ioctl open read unlink write };
allow wo_ipsec epdg_ipsec_conf_file:sock_file { create setattr unlink write };
allow wo_ipsec kernel:system module_request;
allow wo_ipsec node:udp_socket node_bind;
allow wo_ipsec port:tcp_socket name_connect;
allow wo_ipsec port:udp_socket name_bind;
allow wo_ipsec proc_modules:file { getattr read };
allow wo_ipsec proc_net:file { getattr open };
allow wo_ipsec proc_net:file write;
allow wo_ipsec self:capability2 wake_alarm;
allow wo_ipsec self:tcp_socket { connect create getattr getopt read write };
allow wo_ipsec self:udp_socket { bind create read setopt write };
allow wo_ipsec self:{ netlink_route_socket netlink_xfrm_socket } { bind create nlmsg_read nlmsg_write read write };
allow wo_ipsec vendor_configs_file:file ioctl;
allow wo_ipsec vendor_shell_exec:file { getattr no_x_file_perms open read };
allow wo_ipsec vendor_toolbox_exec:file { getattr no_x_file_perms };
allow wo_ipsec wo_charon_exec:file execute_no_trans;
allow wo_ipsec wo_epdg_client:fd use;
allow wo_ipsec wo_epdg_client:unix_stream_socket { connectto read write };
