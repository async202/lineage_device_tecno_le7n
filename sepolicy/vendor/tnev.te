type tnev, domain;
type tnev_exec, exec_type, file_type, vendor_file_type;

binder_call(tnev, tneengine)
binder_call({ domain -ephemeral_app -init -installd -iorapd -isolated_app -mediaprovider -runas_app -servicemanager -simpleperf -untrusted_app -untrusted_app_29 -untrusted_app_27 -untrusted_app_25 -vendor_init -vold }, tnev)

hal_server_domain(tnev, hal_tnev)

hwbinder_use(tnev)

init_daemon_domain(tnev)

allow tnev tneengine_tnek_file:chr_file read;
allow tnev tneengine_tnek_file:chr_file w_file_perms;
