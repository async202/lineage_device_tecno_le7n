type wfca, domain, mtkimsmddomain;
type wfca_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(wfca)

net_domain(wfca)

allow wfca ccci_device:chr_file { ioctl open read write };
allow wfca fwmarkd_socket:sock_file write;
allow wfca node:{ rawip_socket udp_socket } node_bind;
allow wfca port:udp_socket name_bind;
allow wfca self:capability { net_admin net_raw setgid setuid };
allow wfca self:capability2 block_suspend;
allow wfca self:packet_socket { create read setopt };
allow wfca self:rawip_socket { bind create getattr read setopt write };
allow wfca self:udp_socket { bind create getattr ioctl read setopt shutdown write };
allow wfca sysfs_wake_lock:file { open read write };
allow wfca volte_ua:fd use;
allow wfca volte_ua:udp_socket { getattr getopt read setopt shutdown write };
allow wfca wfca_socket:sock_file write;

dontaudit wfca self:capability dac_override;
