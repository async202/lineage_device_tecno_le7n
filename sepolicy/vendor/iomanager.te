type iomanager, domain;
type iomanager_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(iomanager)

allow iomanager block_device:dir search;
allow iomanager cgroup:dir { add_name create open read };
allow iomanager cgroup:file { getattr read write };
allow iomanager cgroup_bpf:dir create_dir_perms;
allow iomanager cgroup_bpf:file create_file_perms;
allow iomanager proc_dirty:file { open read write };
allow iomanager proc_extra_free_kbytes:file { open read write };
allow iomanager proc_f2fs_status:file { getattr open read write };
allow iomanager proc_iomanager:file { open read write };
allow iomanager proc_iomanager_fs:file { getattr open read write };
allow iomanager proc_meminfo:file { getattr open read };
allow iomanager sysfs_filemap:dir { read search };
allow iomanager sysfs_filemap:file { open read write };
allow iomanager sysfs_fs_f2fs:dir search;
allow iomanager sysfs_fs_f2fs:file { getattr open read write };
allow iomanager sysfs_page_writeback:dir { read search };
allow iomanager sysfs_page_writeback:file { open read write };
