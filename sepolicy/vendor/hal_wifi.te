type hal_wifi_default, domain;
type hal_wifi_default_exec, exec_type, file_type, vendor_file_type;

hal_server_domain(hal_wifi_default, hal_wifi)

init_daemon_domain(hal_wifi_default)

allow hal_wifi wmtWifi_device:chr_file w_file_perms;

neverallow hal_wifi_default sysfs:file { audit_access entrypoint execmod execute execute_no_trans mounton no_w_file_perms quotaon relabelto watch_mount watch_sb watch_with_perm };
