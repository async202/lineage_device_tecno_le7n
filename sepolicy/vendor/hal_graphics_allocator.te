type hal_graphics_allocator_default, domain;
type hal_graphics_allocator_default_exec, exec_type, file_type, vendor_file_type;

hal_server_domain(hal_graphics_allocator_default, hal_graphics_allocator)

init_daemon_domain(hal_graphics_allocator_default)

tmpfs_domain(hal_graphics_allocator_default)

allow hal_graphics_allocator proc_ged:file r_file_perms;
allow hal_graphics_allocator_default debugfs_ion:dir search;
allow hal_graphics_allocator_default debugfs_tracing:file open;
allow hal_graphics_allocator_default debugfs_tracing:file write;
allow hal_graphics_allocator_default gpu_device:dir search;
allow hal_graphics_allocator_default mobicore_user_device:chr_file rw_file_perms;
allow hal_graphics_allocator_default proc_ged:file r_file_perms;
allow hal_graphics_allocator_default sw_sync_device:chr_file { getattr ioctl open read write };
allow hal_graphics_allocator_default teei_client_device:chr_file rw_file_perms;

allowxperm hal_graphics_allocator_default proc_ged:file ioctl { 0x6700 0x6704 0x6705 0x6706 0x6707 0x6708 0x6709 0x670a 0x670b 0x670c 0x670d 0x670e 0x670f 0x6764 0x6765 0x6766 0x6767 0x6768 0x6769 0x676a FUNCTIONFS_CLEAR_HALT FUNCTIONFS_FIFO_FLUSH FUNCTIONFS_FIFO_STATUS };

dontaudit hal_graphics_allocator_default unlabeled:dir search;

neverallow hal_graphics_allocator_default proc:file { audit_access entrypoint execmod execute execute_no_trans mounton no_w_file_perms quotaon relabelto watch_mount watch_sb watch_with_perm };
