type ipsec_mon, domain;
type ipsec_mon_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(ipsec_mon)

set_prop(ipsec_mon, vendor_mtk_network_prop)

allow ipsec_mon devpts:chr_file { open read write };
allow ipsec_mon ims_ipsec_data_file:dir { add_name search write };
allow ipsec_mon ims_ipsec_data_file:file { append create getattr ioctl open read setattr write };
allow ipsec_mon proc_net:file { open write };
allow ipsec_mon self:capability { net_admin net_raw };
allow ipsec_mon self:key_socket { create read setopt write };
allow ipsec_mon self:netlink_route_socket { bind connect create nlmsg_read nlmsg_write read write };
allow ipsec_mon self:netlink_xfrm_socket { bind create nlmsg_read nlmsg_write read write };
allow ipsec_mon self:udp_socket { create ioctl };

allowxperm ipsec_mon self:udp_socket ioctl { SIOCDEVPRIVATE SIOCDEVPRIVATE_2 };

dontaudit ipsec_mon kernel:system module_request;
