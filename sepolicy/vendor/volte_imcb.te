type volte_imcb, domain, mtkimsmddomain;
type volte_imcb_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(volte_imcb)

net_domain(volte_imcb)

set_prop(volte_imcb, vendor_mtk_md_volte_prop)

unix_socket_connect(volte_imcb, netd, init)
unix_socket_connect(volte_imcb, netd, netd)
unix_socket_connect(volte_imcb, netd, volte_ua)
unix_socket_connect(volte_imcb, property, netd)
unix_socket_connect(volte_imcb, property, volte_ua)
unix_socket_connect(volte_imcb, volte_imcb, init)
unix_socket_connect(volte_imcb, volte_imcb, netd)
unix_socket_connect(volte_imcb, volte_imcb, volte_ua)
unix_socket_connect(volte_imcb, volte_ua, init)
unix_socket_connect(volte_imcb, volte_ua, netd)
unix_socket_connect(volte_imcb, volte_ua, volte_ua)
unix_socket_connect(volte_imcb, volte_ut, init)
unix_socket_connect(volte_imcb, volte_ut, netd)
unix_socket_connect(volte_imcb, volte_ut, volte_ua)

allow volte_imcb ccci_device:chr_file rw_file_perms;
allow volte_imcb devpts:chr_file setattr;
allow volte_imcb mtk_radio_device:dir w_dir_perms;
allow volte_imcb mtk_radio_device:lnk_file create_file_perms;
allow volte_imcb node:tcp_socket node_bind;
allow volte_imcb port:tcp_socket name_bind;
allow volte_imcb self:capability { setgid setuid };
allow volte_imcb self:capability2 wake_alarm;
allow volte_imcb self:tcp_socket { accept bind create listen setopt };
allow volte_imcb self:tcp_socket { getattr read };
allow volte_imcb self:tcp_socket write;
allow volte_imcb sysfs_ccci:dir search;
allow volte_imcb sysfs_ccci:file r_file_perms;
