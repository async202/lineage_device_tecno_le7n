type hal_drm_clearkey, domain;
type hal_drm_clearkey_exec, exec_type, file_type, vendor_file_type;

hal_server_domain(hal_drm_clearkey, hal_drm)

init_daemon_domain(hal_drm_clearkey)

vndbinder_use(hal_drm_clearkey)

allow hal_drm_clearkey { appdomain -isolated_app }:fd use;

neverallow hal_drm_clearkey sysfs:file { audit_access entrypoint execmod execute execute_no_trans mounton no_w_file_perms quotaon relabelto watch_mount watch_sb watch_with_perm };
neverallow hal_drm_clearkey system_data_file:file { audit_access entrypoint execmod execute execute_no_trans ioctl lock map mounton no_w_file_perms open quotaon relabelto watch watch_mount watch_reads watch_sb watch_with_perm };
