type hal_gnss_default, domain;
type hal_gnss_default_exec, exec_type, file_type, vendor_file_type;

hal_server_domain(hal_gnss_default, hal_gnss)

init_daemon_domain(hal_gnss_default)

vndbinder_use(hal_gnss)

allow hal_gnss_default mnld:unix_dgram_socket sendto;
allow hal_gnss_default mnld_data_file:dir { append create getattr ioctl lock map open read rename setattr unlink watch watch_reads write };
allow hal_gnss_default mnld_data_file:dir rw_dir_perms;
allow hal_gnss_default mnld_data_file:sock_file create_file_perms;
allow hal_gnss_default mnld_data_file:sock_file rw_file_perms;
