type wo_epdg_client, domain;
type wo_epdg_client_exec, exec_type, file_type, vendor_file_type;

domain_auto_trans(wo_epdg_client, netutils_wrapper_exec, netutils_wrapper)
domain_auto_trans(wo_epdg_client, wo_charon_exec, wo_ipsec)
domain_auto_trans(wo_epdg_client, wo_starter_exec, wo_ipsec)
domain_auto_trans(wo_epdg_client, wo_stroke_exec, wo_ipsec)

init_daemon_domain(wo_epdg_client)

net_domain(wo_epdg_client)

set_prop(wo_epdg_client, vendor_mtk_persist_epdg_prop)

unix_socket_connect(wo_epdg_client, dnsproxyd, init)
unix_socket_connect(wo_epdg_client, dnsproxyd, netd)
unix_socket_connect(wo_epdg_client, netd, init)
unix_socket_connect(wo_epdg_client, netd, netd)
unix_socket_connect(wo_epdg_client, property, netd)

allow wo_epdg_client devpts:chr_file { open read write };
allow wo_epdg_client epdg_apn_conf_file:dir { add_name open read remove_name search write };
allow wo_epdg_client epdg_apn_conf_file:file { create getattr open unlink write };
allow wo_epdg_client epdg_ipsec_conf_file:dir { add_name open read remove_name search write };
allow wo_epdg_client epdg_ipsec_conf_file:file { create getattr open read unlink write };
allow wo_epdg_client kernel:process signal;
allow wo_epdg_client kernel:system module_request;
allow wo_epdg_client self:capability { kill net_admin setgid setuid };
allow wo_epdg_client self:capability net_raw;
allow wo_epdg_client self:capability { setgid setuid };
allow wo_epdg_client self:capability sys_module;
allow wo_epdg_client self:netlink_route_socket { bind create getattr nlmsg_read nlmsg_write read setopt write };
allow wo_epdg_client self:netlink_xfrm_socket { bind create getattr nlmsg_write read setopt write };
allow wo_epdg_client self:rawip_socket { create getopt setopt };
allow wo_epdg_client self:tun_socket { create relabelfrom relabelto };
allow wo_epdg_client self:udp_socket { create ioctl };
allow wo_epdg_client system_server:process { signal signull };
allow wo_epdg_client tun_device:chr_file { getattr ioctl open read write };
allow wo_epdg_client vendor_shell_exec:file { no_x_file_perms open read };
allow wo_epdg_client wo_ipsec:process { sigkill signal signull };
allow wo_epdg_client wo_ipsec_exec:file { getattr no_x_file_perms open read };

allowxperm wo_epdg_client self:udp_socket ioctl { SIOCSIFADDR SIOCSIFFLAGS SIOCSIFMTU };
