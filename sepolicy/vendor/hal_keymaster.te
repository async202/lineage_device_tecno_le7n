type hal_keymaster_default, domain;
type hal_keymaster_default_exec, exec_type, file_type, vendor_file_type;

get_prop(hal_keymaster_default, vendor_security_patch_level_prop)

hal_attribute_hwservice(hal_keymaster, mtk_hal_keyinstall_hwservice)
hal_attribute_hwservice(hal_keymaster, mtk_hal_keymanage_hwservice)

hal_client_domain(hal_keymaster_default, hal_allocator)
hal_client_domain(hal_keymaster_default, hal_capi)

hal_server_domain(hal_keymaster_default, hal_keymaster)

init_daemon_domain(hal_keymaster_default)

set_prop(hal_keymaster_default, vendor_mtk_soter_teei_prop)

unix_socket_connect(hal_keymaster_default, property, kisd)

allow hal_keymaster_default debugfs_tracing:file write;
allow hal_keymaster_default mnt_vendor_file:dir search;
allow hal_keymaster_default mobicore:unix_stream_socket { connectto read write };
allow hal_keymaster_default mobicore_user_device:chr_file rw_file_perms;
allow hal_keymaster_default persist_data_file:dir search;
allow hal_keymaster_default persist_data_file:file { getattr open read };
allow hal_keymaster_default teei_client_device:chr_file { ioctl open read write };
allow hal_keymaster_default tkcore_admin_device:chr_file { ioctl open read write };
allow hal_keymaster_default ut_keymaster_device:chr_file { ioctl open read write };
