get_prop(priv_app, vendor_default_prop)

hal_client_domain(priv_app, hal_allocator)
hal_client_domain(priv_app, hal_pq)

allow priv_app debugfs_ion:dir search;
allow priv_app freezed_device:chr_file { getattr ioctl open read write };
allow priv_app mtk_radio_service:service_manager find;
allow priv_app os_appfly_file:dir r_dir_perms;
allow priv_app os_appfly_file:file r_file_perms;
allow priv_app proc_mtk_jpeg:file rw_file_perms;
allow priv_app tranfs_file:dir { add_name create getattr open read search write };
allow priv_app tranfs_file:file { append create getattr open read write };
allow priv_app tranlog_device:chr_file { open read write };
allow priv_app tranphone_service:service_manager find;
allow priv_app transsion_uxdetector_service:service_manager find;
allow priv_app transsion_uxdetectorrest_service:service_manager find;

allowxperm priv_app proc_mtk_jpeg:file ioctl { 0x7812 0x7813 0x7814 };
