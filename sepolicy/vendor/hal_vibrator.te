# type hal_vibrator_default, domain;
# type hal_vibrator_default_exec, exec_type, file_type, vendor_file_type;

hal_server_domain(hal_vibrator_default, hal_vibrator)

init_daemon_domain(hal_vibrator_default)

allow hal_vibrator sysfs_leds:dir r_dir_perms;
allow hal_vibrator sysfs_leds:file rw_file_perms;
allow hal_vibrator sysfs_leds:lnk_file read;
allow hal_vibrator sysfs_vibrator:dir r_dir_perms;
allow hal_vibrator_default sysfs_vibrator:file rw_file_perms;
