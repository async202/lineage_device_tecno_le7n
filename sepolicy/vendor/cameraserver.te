binder_call(cameraserver, hal_graphics_allocator)
binder_call(cameraserver, mtk_hal_camera)
binder_call(cameraserver, trancamserver)

allow cameraserver debugfs_ion:dir search;
allow cameraserver dri_device:chr_file { ioctl open read write };
allow cameraserver fuse:dir { add_name create search write };
allow cameraserver fuse:dir create_dir_perms;
allow cameraserver fuse:file { create getattr open read write };
allow cameraserver fuse:file create_file_perms;
allow cameraserver gpu_device:chr_file rw_file_perms;
allow cameraserver gpu_device:dir search;
allow cameraserver graphics_device:chr_file rw_file_perms;
allow cameraserver hal_trancamserver_hwservice:hwservice_manager find;
allow cameraserver media_rw_data_file:dir create_dir_perms;
allow cameraserver media_rw_data_file:file create_file_perms;
allow cameraserver mtk_perf_service:service_manager find;
allow cameraserver proc_ged:file rw_file_perms;
allow cameraserver proc_perfmgr:dir { read search };
allow cameraserver proc_perfmgr:file r_file_perms;
allow cameraserver sdcardfs:dir create_dir_perms;
allow cameraserver sdcardfs:file create_file_perms;
allow cameraserver self:process ptrace;
allow cameraserver stmvl53l1_ranging_device:chr_file { append getattr ioctl lock open read write };
allow cameraserver sysfs_sub_torch_file:file rw_file_perms;
allow cameraserver sysfs_torch_file:file rw_file_perms;
allow cameraserver sysfs_wide_torch_file:file rw_file_perms;
allow cameraserver system_file:dir { open read };
allow cameraserver tmpfs:dir search;
allow cameraserver vtservice:binder { call transfer };
allow cameraserver vtservice:fd use;

allowxperm cameraserver proc_ged:file ioctl { 0x6700 0x6704 0x6705 0x6706 0x6707 0x6708 0x6709 0x670a 0x670b 0x670c 0x670d 0x670e 0x670f 0x6764 0x6765 0x6766 0x6767 0x6768 0x6769 0x676a FUNCTIONFS_CLEAR_HALT FUNCTIONFS_FIFO_FLUSH FUNCTIONFS_FIFO_STATUS };
allowxperm cameraserver proc_perfmgr:file ioctl { 0x670f 0x6710 FUNCTIONFS_CLEAR_HALT FUNCTIONFS_FIFO_STATUS };
