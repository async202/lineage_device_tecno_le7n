type res_monitor, domain;
type res_monitor_exec, exec_type, file_type, vendor_file_type;

hal_server_domain(res_monitor, hal_res_monitor)

hwbinder_use(res_monitor)

init_daemon_domain(res_monitor)

allow res_monitor proc_f2fs_status:file { getattr open read };
allow res_monitor proc_meminfo:file { getattr open read };
allow res_monitor proc_resmonitor:file { getattr open read };
allow res_monitor proc_stat:file { getattr open read };
allow res_monitor proc_uid_io_stats:file { getattr open read };
allow res_monitor proc_vmstat:file { getattr open read };
allow res_monitor sysfs_resmonitor:dir search;
allow res_monitor sysfs_resmonitor:file { open write };
allow res_monitor system_server:binder call;
allow res_monitor tranlog_data_file:dir search;
allow res_monitor tranlog_data_file:file { getattr open read write };
allow res_monitor tranlog_device:chr_file ioctl;
allow res_monitor tranlog_device:chr_file { open read write };
