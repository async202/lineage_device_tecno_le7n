# type hal_fingerprint_default, domain;
# type hal_fingerprint_default_exec, exec_type, file_type, vendor_file_type;

binder_call(hal_fingerprint_default, system_app)

# hal_server_domain(hal_fingerprint_default, hal_fingerprint)

# init_daemon_domain(hal_fingerprint_default)

set_prop(hal_fingerprint_default, vendor_silead_fp_prop)

unix_socket_connect(hal_fingerprint_default, property, mobicore)
unix_socket_connect(hal_fingerprint_default, property, mobicore_user_device)
unix_socket_connect(hal_fingerprint_default, property, self)

allow hal_fingerprint_default debugfs_trace_marker:file rw_file_perms;
allow hal_fingerprint_default fingerprint_device:chr_file rw_file_perms;
allow hal_fingerprint_default fp_ext_svc2_service:hwservice_manager add;
allow hal_fingerprint_default fpsensor_fp_device:chr_file { ioctl open read write };
allow hal_fingerprint_default fuse:dir search;
allow hal_fingerprint_default hal_capi_default:binder { call transfer };
allow hal_fingerprint_default hal_capi_default:fd use;
allow hal_fingerprint_default hal_capi_hwservice:hwservice_manager find;
allow hal_fingerprint_default hidl_memory_hwservice:hwservice_manager find;
allow hal_fingerprint_default mnt_user_file:dir search;
allow hal_fingerprint_default mnt_user_file:lnk_file read;
allow hal_fingerprint_default mobicore_data_file:dir r_dir_perms;
allow hal_fingerprint_default mobicore_data_file:file r_file_perms;
allow hal_fingerprint_default mobicore_user_device:chr_file rw_file_perms;
allow hal_fingerprint_default platform_app:binder call;
allow hal_fingerprint_default proc_ppm:dir search;
allow hal_fingerprint_default proc_ppm:file { getattr open read write };
allow hal_fingerprint_default self:netlink_socket create_socket_perms_no_ioctl;
allow hal_fingerprint_default self:unix_stream_socket { connectto create_stream_socket_perms };
allow hal_fingerprint_default silead_fpd_data_file:dir rw_dir_perms;
allow hal_fingerprint_default silead_fpd_data_file:file create_file_perms;
allow hal_fingerprint_default silead_fpd_device:chr_file rw_file_perms;
allow hal_fingerprint_default storage_file:lnk_file read;
allow hal_fingerprint_default sysfs_backlight_file:file { open read write };
allow hal_fingerprint_default sysfs_batteryinfo:dir search;
allow hal_fingerprint_default sysfs_batteryinfo:file { open read };
allow hal_fingerprint_default sysfs_devices_system_cpu:file { read write };
allow hal_fingerprint_default sysfs_fp_name_path:dir r_dir_perms;
allow hal_fingerprint_default sysfs_fp_name_path:file rw_file_perms;
allow hal_fingerprint_default sysfs_lcm_hbm_file:file { getattr open read write };
allow hal_fingerprint_default sysfs_leds:dir { read search };
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default teei_client_device:chr_file { ioctl open read write };
allow hal_fingerprint_default teei_control_file:dir { open read search };
allow hal_fingerprint_default teei_control_file:{ file lnk_file } { open read write };
allow hal_fingerprint_default teei_fp_device:chr_file { ioctl open read write };
allow hal_fingerprint_default tkcore_admin_device:chr_file rw_file_perms;
allow hal_fingerprint_default tmpfs:chr_file rw_file_perms;
allow hal_fingerprint_default tranlog_device:chr_file { ioctl open read write };
allow hal_fingerprint_default uhid_device:chr_file { ioctl open read write };
allow hal_fingerprint_default uhid_device:chr_file rw_file_perms;

# neverallow hal_fingerprint_default sysfs:file { audit_access entrypoint execmod execute execute_no_trans mounton no_w_file_perms quotaon relabelto watch_mount watch_sb watch_with_perm };
