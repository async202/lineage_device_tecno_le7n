type atcid, domain;
type atcid_exec, exec_type, file_type, vendor_file_type;

get_prop(atcid, vendor_mtk_tel_switch_prop)

hal_client_domain(atcid, hal_pq)
hal_client_domain(atcid, hal_telephony)

hal_server_domain(atcid, hal_atci)

hwbinder_use(atcid)

init_daemon_domain(atcid)

set_prop(atcid, powerctl_prop)
set_prop(atcid, vendor_mtk_atci_prop)
set_prop(atcid, vendor_mtk_persist_service_atci_prop)

unix_socket_connect(atcid, adb_atci, atci_service)
unix_socket_connect(atcid, adb_atci, audiocmdservice_atci)
unix_socket_connect(atcid, adb_atci, init)
unix_socket_connect(atcid, adb_atci, meta_tst)
unix_socket_connect(atcid, adb_atci, rild)
unix_socket_connect(atcid, atci-audio, atci_service)
unix_socket_connect(atcid, atci-audio, audiocmdservice_atci)
unix_socket_connect(atcid, atci-audio, init)
unix_socket_connect(atcid, atci-audio, meta_tst)
unix_socket_connect(atcid, atci-audio, rild)
unix_socket_connect(atcid, atci_service, atci_service)
unix_socket_connect(atcid, atci_service, audiocmdservice_atci)
unix_socket_connect(atcid, atci_service, init)
unix_socket_connect(atcid, atci_service, meta_tst)
unix_socket_connect(atcid, atci_service, rild)
unix_socket_connect(atcid, gsmrild, atci_service)
unix_socket_connect(atcid, gsmrild, audiocmdservice_atci)
unix_socket_connect(atcid, gsmrild, init)
unix_socket_connect(atcid, gsmrild, meta_tst)
unix_socket_connect(atcid, gsmrild, rild)
unix_socket_connect(atcid, meta_atci, atci_service)
unix_socket_connect(atcid, meta_atci, audiocmdservice_atci)
unix_socket_connect(atcid, meta_atci, init)
unix_socket_connect(atcid, meta_atci, meta_tst)
unix_socket_connect(atcid, meta_atci, rild)
unix_socket_connect(atcid, property, atci_service)
unix_socket_connect(atcid, property, audiocmdservice_atci)
unix_socket_connect(atcid, property, meta_tst)
unix_socket_connect(atcid, property, rild)
unix_socket_connect(atcid, rild_atci, atci_service)
unix_socket_connect(atcid, rild_atci, audiocmdservice_atci)
unix_socket_connect(atcid, rild_atci, init)
unix_socket_connect(atcid, rild_atci, meta_tst)
unix_socket_connect(atcid, rild_atci, rild)
unix_socket_connect(atcid, rilproxy_atci, atci_service)
unix_socket_connect(atcid, rilproxy_atci, audiocmdservice_atci)
unix_socket_connect(atcid, rilproxy_atci, init)
unix_socket_connect(atcid, rilproxy_atci, meta_tst)
unix_socket_connect(atcid, rilproxy_atci, rild)

vndbinder_use(atcid)

allow atcid block_device:dir search;
allow atcid misc2_block_device:blk_file { open read write };
allow atcid mnt_vendor_file:dir search;
allow atcid nvdata_file:dir { add_name open read search write };
allow atcid nvdata_file:file { create getattr open read setattr write };
allow atcid nvram_device:blk_file { open read write };
allow atcid proc_ged:file rw_file_perms;
allow atcid proc_meminfo:file { open read };
allow atcid self:capability sys_time;
allow atcid self:unix_stream_socket ioctl;
allow atcid sysfs_batteryinfo:dir search;
allow atcid sysfs_batteryinfo:file { open read };
allow atcid sysfs_devices_block:dir search;
allow atcid sysfs_devices_block:file { open read };
allow atcid ttyGS_device:chr_file { ioctl open read write };
allow atcid wmtWifi_device:chr_file { open write };

allowxperm atcid self:unix_stream_socket ioctl { SNDCTL_TMR_START TCFLSH };
