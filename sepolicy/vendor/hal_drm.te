# type hal_drm_default, domain;
# type hal_drm_default_exec, exec_type, file_type, vendor_file_type;

# hal_server_domain(hal_drm_default, hal_drm)

# init_daemon_domain(hal_drm_default)

vndbinder_use(hal_drm_default)

allow hal_drm_default debugfs_ion:dir search;
allow hal_drm_default debugfs_tracing:file write;
allow hal_drm_default hal_codec2_server:fd use;
allow hal_drm_default hal_omx_server:fd use;

# neverallow hal_drm_default sysfs:file { audit_access entrypoint execmod execute execute_no_trans mounton no_w_file_perms quotaon relabelto watch_mount watch_sb watch_with_perm };
# neverallow hal_drm_default system_data_file:file { audit_access entrypoint execmod execute execute_no_trans ioctl lock map mounton no_w_file_perms open quotaon relabelto watch watch_mount watch_reads watch_sb watch_with_perm };
