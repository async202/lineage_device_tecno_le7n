permissive hal_audio_default;

allow hal_audio_default vendor_data_file:dir create_dir_perms;
allow hal_audio_default vendor_data_file:file create_file_perms;
allow hal_audio_default sysfs:file { read write open getattr };
allow hal_audio_default ccci_device:chr_file rw_file_perms;
allow hal_audio_default audio_device:chr_file rw_file_perms;
allow hal_audio_default audio_device:dir r_dir_perms;
allow hal_audio_default nvdata_file:dir create_dir_perms;
allow hal_audio_default nvdata_file:file create_file_perms;
allow hal_audio_default nvdata_file:lnk_file read;
allow hal_audio_default nvram_data_file:dir create_dir_perms;
allow hal_audio_default nvram_data_file:file create_file_perms;
allow hal_audio_default nvram_data_file:lnk_file read;
allow hal_audio_default proc_ged:file rw_file_perms;
allow hal_audio_default hal_mtkpower_hwservice:hwservice_manager find;
