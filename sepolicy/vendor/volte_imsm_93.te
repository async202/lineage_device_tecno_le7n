type volte_imsm_93, domain, mtkimsmddomain;
type volte_imsm_93_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(volte_imsm_93)

net_domain(volte_imsm_93)

set_prop(volte_imsm_93, vendor_mtk_md_volte_prop)
set_prop(volte_imsm_93, vendor_mtk_ril_mux_report_case_prop)

unix_socket_connect(volte_imsm_93, property, volte_imcb)
unix_socket_connect(volte_imsm_93, volte_imsa, init)
unix_socket_connect(volte_imsm_93, volte_imsa, volte_imcb)

allow volte_imsm_93 ccci_device:chr_file rw_file_perms;
allow volte_imsm_93 devpts:chr_file { rw_file_perms setattr };
allow volte_imsm_93 mtk_radio_device:dir w_dir_perms;
allow volte_imsm_93 mtk_radio_device:lnk_file create_file_perms;
allow volte_imsm_93 self:capability { chown net_admin setgid setuid };
allow volte_imsm_93 self:netlink_generic_socket { bind connect create getattr read setopt write };
allow volte_imsm_93 self:netlink_route_socket { bind connect create getattr nlmsg_read nlmsg_write read setopt write };
allow volte_imsm_93 self:udp_socket { bind create getattr ioctl read setopt shutdown write };
