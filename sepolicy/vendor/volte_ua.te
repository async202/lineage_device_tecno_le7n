type volte_ua, domain, mtkimsmddomain;
type volte_ua_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(volte_ua)

net_domain(volte_ua)

unix_socket_connect(volte_ua, netd, netd)
unix_socket_connect(volte_ua, netd, volte_stack)
unix_socket_connect(volte_ua, netd, wfca)
unix_socket_connect(volte_ua, volte_stack, netd)
unix_socket_connect(volte_ua, volte_stack, volte_stack)
unix_socket_connect(volte_ua, volte_stack, wfca)
unix_socket_connect(volte_ua, volte_ua, netd)
unix_socket_connect(volte_ua, volte_ua, volte_stack)
unix_socket_connect(volte_ua, volte_ua, wfca)
unix_socket_connect(volte_ua, wfca, netd)
unix_socket_connect(volte_ua, wfca, volte_stack)
unix_socket_connect(volte_ua, wfca, wfca)

allow volte_ua node:udp_socket node_bind;
allow volte_ua self:capability { setgid setuid };
allow volte_ua self:capability2 wake_alarm;
allow volte_ua self:udp_socket { bind create };
allow volte_ua self:udp_socket read;
allow volte_ua self:udp_socket setopt;
