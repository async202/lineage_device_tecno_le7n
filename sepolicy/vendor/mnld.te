type mnld, domain, mlstrustedsubject;
type mnld_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(mnld)
net_domain(mnld)
hwbinder_use(mnld)
binder_call(mnld, system_server)
get_prop(mnld, hwservicemanager_prop)
set_prop(mnld, vendor_default_prop)
allow mnld fwk_sensor_hwservice:hwservice_manager find;

allow { mnld hal_gnss hal_gnss_default } mnld_socket:sock_file create_file_perms;
allow { mnld hal_gnss hal_gnss_default } mnld_data_file:dir create_dir_perms;
allow { mnld hal_gnss hal_gnss_default } mnld_data_file:file create_file_perms;
allow { mnld hal_gnss hal_gnss_default } mnld_data_file:sock_file create_file_perms;
allow { mnld hal_gnss hal_gnss_default } gps_data_file:dir create_dir_perms;
allow { mnld hal_gnss hal_gnss_default } gps_data_file:file create_file_perms;
allow { mnld hal_gnss hal_gnss_default } gps_data_file:sock_file create_file_perms;
allow { hal_gnss hal_gnss_default } mnld:unix_dgram_socket sendto;
allow mnld { hal_gnss hal_gnss_default }:unix_dgram_socket sendto;

allow mnld gps_emi_device:chr_file rw_file_perms;
allow mnld stpgps_device:chr_file rw_file_perms;
allow mnld gpsdl_device:chr_file rw_file_perms;
allow mnld mnld_device:chr_file rw_file_perms;
allow mnld nvdata_file:dir create_dir_perms;
allow mnld nvdata_file:file create_file_perms;
allow mnld nvram_data_file:dir create_dir_perms;
allow mnld nvram_data_file:file create_file_perms;
allow mnld nvcfg_file:dir create_dir_perms;
allow mnld nvcfg_file:file create_file_perms;
allow mnld mnld:capability2 wake_alarm;
allow mnld self:capability { fsetid net_admin net_raw };
allow mnld self:udp_socket create_socket_perms;
allow mnld block_device:dir search;
allow mnld sysfs:dir r_dir_perms;
allow mnld sysfs:file r_file_perms;
allow mnld sysfs_leds:dir search;
allow mnld sysfs_leds:file r_file_perms;
allow mnld sysfs_wake_lock:file rw_file_perms;
allow mnld mnt_vendor_file:dir create_dir_perms;
allow mnld mnt_vendor_file:file create_file_perms;
allow mnld mnt_user_file:dir search;
allow mnld mnt_user_file:lnk_file read;
allow mnld proc_cmdline:file r_file_perms;
allow mnld sysfs_dt_firmware_android:dir search;
allow mnld sysfs_dt_firmware_android:file r_file_perms;
allow mnld default_prop:file r_file_perms;
allow mnld { protect_f_data_file protect_s_data_file }:dir create_dir_perms;
allow mnld { protect_f_data_file protect_s_data_file }:file create_file_perms;
allow mnld mtk_agpsd:unix_dgram_socket sendto;
