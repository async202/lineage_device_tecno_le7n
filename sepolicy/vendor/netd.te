get_prop(netd, vendor_mtk_app_prop)

allow netd bip:fd use;
allow netd bip:{ tcp_socket udp_socket } { getopt read setopt write };
allow netd dhcp6s_exec:file execute;
allow netd epdg_wod:fd use;
allow netd epdg_wod:{ tcp_socket udp_socket } { getopt read setopt write };
allow netd ipsec:fd use;
allow netd ipsec:{ tcp_socket udp_socket } { getopt read setopt write };
allow netd isolated_app:fd use;
allow netd mdlogger:fd use;
allow netd mdlogger:tcp_socket { getopt setopt };
allow netd mdlogger:tcp_socket { read write };
allow netd mtk_perf_service:service_manager find;
allow netd netdiag:fd use;
allow netd netdiag:udp_socket { getopt read setopt write };
allow netd platform_app:fd use;
allow netd ppp:process sigkill;
allow netd self:capability fsetid;
allow netd self:capability { setgid setuid };
allow netd teeregistryd_app:fd use;
allow netd teeregistryd_app:tcp_socket { getopt read setopt write };
allow netd untrusted_app:fd use;
allow netd untrusted_app:unix_stream_socket { getopt read setopt write };
allow netd volte_imcb:fd use;
allow netd volte_imcb:{ tcp_socket udp_socket } { getopt read setopt write };
allow netd volte_stack:fd use;
allow netd volte_stack:{ tcp_socket udp_socket } { getopt read setopt write };
allow netd volte_ua:fd use;
allow netd volte_ua:{ tcp_socket udp_socket } { getopt read setopt write };
allow netd vtservice:fd use;
allow netd vtservice:udp_socket { getopt read setopt write };
allow netd wmtWifi_device:chr_file { open write };
allow netd wo_epdg_client:fd use;
allow netd wo_epdg_client:{ tcp_socket udp_socket } { getopt read setopt write };
allow netd wo_ipsec:fd use;
allow netd wo_ipsec:{ tcp_socket udp_socket } { getopt read setopt write };
