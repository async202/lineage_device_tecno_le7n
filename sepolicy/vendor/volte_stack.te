type volte_stack, domain, mtkimsmddomain;
type volte_stack_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(volte_stack)

net_domain(volte_stack)

unix_socket_connect(volte_stack, netd, netd)
unix_socket_connect(volte_stack, volte_stack, netd)

allow volte_stack node:{ tcp_socket udp_socket } node_bind;
allow volte_stack port:tcp_socket name_connect;
allow volte_stack port:{ tcp_socket udp_socket } name_bind;
allow volte_stack self:capability net_admin;
allow volte_stack self:capability { setgid setuid };
allow volte_stack self:key_socket { create read setopt write };
allow volte_stack self:netlink_xfrm_socket { bind create nlmsg_read nlmsg_write read write };
allow volte_stack self:tcp_socket accept;
allow volte_stack self:tcp_socket { bind create listen setopt };
allow volte_stack self:tcp_socket connect;
allow volte_stack self:tcp_socket getattr;
allow volte_stack self:tcp_socket read;
allow volte_stack self:tcp_socket write;
allow volte_stack self:udp_socket { bind read setopt write };
allow volte_stack self:udp_socket create;
allow volte_stack self:{ tcp_socket udp_socket } shutdown;
