get_prop(installd, vendor_default_prop)

allow installd apk_tmp_file:dir getattr;
allow installd dalvikcache_data_file:lnk_file { create getattr read setattr unlink };
allow installd media_rw_data_file:file { create open read setattr write };
allow installd mnt_user_file:dir { append create getattr open read search write };
allow installd mnt_user_file:lnk_file read;
allow installd platform_app:fd use;
allow installd sdcard_type:dir { add_name create getattr read remove_name search setattr write };
allow installd sdcard_type:file { create getattr open read setattr unlink write };
allow installd shell_exec:file { no_x_file_perms open read };
allow installd tneengine_tnek_file:chr_file w_file_perms;
allow installd tran_proc_f2fs_defrag:file { getattr open read write };
allow installd tranfs_file:dir { add_name create getattr open read remove_name search setattr write };
allow installd tranfs_file:file { append create getattr open read rename setattr unlink write };
allow installd vendor_configs_file:file map;
allow installd vfat:dir search;
allow installd vfat:file getattr;
