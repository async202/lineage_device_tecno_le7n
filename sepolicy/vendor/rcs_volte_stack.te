type rcs_volte_stack, domain, mtkimsapdomain;
type rcs_volte_stack_exec, exec_type, file_type, vendor_file_type;

init_daemon_domain(rcs_volte_stack)

set_prop(rcs_volte_stack, vendor_mtk_network_prop)

unix_socket_connect(rcs_volte_stack, fwmarkd, init)
unix_socket_connect(rcs_volte_stack, rcs_volte_stack, init)

allow rcs_volte_stack node:{ tcp_socket udp_socket } node_bind;
allow rcs_volte_stack port:tcp_socket name_connect;
allow rcs_volte_stack port:{ tcp_socket udp_socket } name_bind;
allow rcs_volte_stack self:capability net_admin;
allow rcs_volte_stack self:capability { setgid setuid };
allow rcs_volte_stack self:key_socket { create read setopt write };
allow rcs_volte_stack self:netlink_xfrm_socket { bind create nlmsg_read nlmsg_write read write };
allow rcs_volte_stack self:{ tcp_socket udp_socket } create_stream_socket_perms;
allow rcs_volte_stack vendor_shell_exec:file { no_x_file_perms open read };
