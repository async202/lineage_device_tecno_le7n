r_dir_file(recovery, proc_kmsg)
r_dir_file(recovery, proc_last_kmsg)
r_dir_file(recovery, proc_pl_lk)

allow recovery block_device:blk_file ioctl;
allow recovery bootdevice_block_device:blk_file rw_file_perms;
allow recovery debugfs_sleep_count:file { getattr open read };
allow recovery dri_device:chr_file { read write };
allow recovery exfat:dir r_dir_perms;
allow recovery exfat:file r_file_perms;
allow recovery gpu_device:dir r_dir_perms;
allow recovery kernel:system syslog_mod;
allow recovery misc_sd_device:chr_file rw_file_perms;
allow recovery mtd_device:chr_file rw_file_perms;
allow recovery mtd_device:dir search;
allow recovery proc_chg_current_limit:file { getattr open read write };
allow recovery proc_dvfsrc:file { getattr open read write };
allow recovery proc_filesystems:file r_file_perms;
allow recovery proc_meminfo:file { getattr open read };
allow recovery proc_mmc_cid:file { getattr open read write };
allow recovery proc_mmc_cid:file { open read write };
allow recovery proc_usb_wake_lock_release:file { getattr open read write };
allow recovery rtc_device:chr_file { ioctl open read };
allow recovery self:capability { fsetid sys_rawio };
allow recovery self:capability fsetid;
allow recovery self:capability ipc_lock;
allow recovery self:capability sys_boot;
allow recovery self:capability sys_resource;
allow recovery self:capability2 syslog;
allow recovery sysfs:dir r_dir_perms;
allow recovery sysfs:dir search;
allow recovery sysfs_backlight_file:file { open read write };
allow recovery sysfs_batteryinfo:dir r_dir_perms;
allow recovery sysfs_boot_type:file r_file_perms;
allow recovery sysfs_devices_block:dir r_dir_perms;
allow recovery sysfs_devices_block:file rw_file_perms;
allow recovery sysfs_devices_block:lnk_file r_file_perms;
allow recovery sysfs_dm:dir search;
allow recovery sysfs_power:file { getattr open read write };
allow recovery sysfs_therm:dir r_dir_perms;
allow recovery sysfs_therm:file r_file_perms;
allow recovery sysfs_zram:dir search;
allow recovery sysfs_zram:file { getattr open read write };
allow recovery tmpfs:lnk_file r_file_perms;
allow recovery tranfs_file:dir { add_name getattr search write };
allow recovery tranfs_file:dir { getattr search };
allow recovery tranfs_file:file { append create getattr open read setattr };
allow recovery vfat:dir r_dir_perms;
allow recovery vfat:file r_file_perms;

allowxperm recovery block_device:blk_file ioctl { BLKALIGNOFF BLKIOMIN };
allowxperm recovery bootdevice_block_device:blk_file ioctl { 0x5388 MMC_IOC_CMD };
allowxperm recovery nvdata_device:blk_file ioctl BLKPBSZGET;
allowxperm recovery tmpfs:file ioctl FS_IOC_FIEMAP;

recovery_only(`
    permissive recovery;
    permissive init;
')
