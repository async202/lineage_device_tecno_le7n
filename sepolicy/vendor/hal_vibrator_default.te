# Allow vibrator HAL to access sysfs_vibrator and sysfs_leds
allow hal_vibrator_default sysfs_vibrator:dir r_dir_perms;
allow hal_vibrator_default sysfs_vibrator:file rw_file_perms;
allow hal_vibrator_default sysfs_leds:dir r_dir_perms;
allow hal_vibrator_default sysfs_leds:file rw_file_perms;
allow hal_vibrator_default sysfs_leds:lnk_file read;
