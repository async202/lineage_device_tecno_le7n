allow appdomain dri_device:chr_file { ioctl open read write };
allow appdomain gpu_device:dir search;
allow appdomain proc_ged:file rw_file_perms;
allow appdomain proc_perfmgr:dir search;
allow appdomain proc_perfmgr:file { getattr ioctl open read };
allow appdomain surfaceflinger:fifo_file rw_file_perms;

allowxperm appdomain appdomain:fifo_file ioctl SNDCTL_TMR_START;
allowxperm appdomain proc_ged:file ioctl { 0x6700 0x6704 0x6705 0x6706 0x6707 0x6708 0x6709 0x670a 0x670b 0x670c 0x670d 0x670e 0x670f 0x6764 0x6765 0x6766 0x6767 0x6768 0x6769 0x676a FUNCTIONFS_CLEAR_HALT FUNCTIONFS_FIFO_FLUSH FUNCTIONFS_FIFO_STATUS };
allowxperm appdomain proc_perfmgr:file ioctl { 0x670f 0x6710 FUNCTIONFS_CLEAR_HALT FUNCTIONFS_FIFO_STATUS };
