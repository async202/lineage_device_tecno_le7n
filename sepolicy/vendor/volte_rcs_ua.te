type volte_rcs_ua, domain, mtkimsapdomain;
type volte_rcs_ua_exec, exec_type, file_type, vendor_file_type;
type volte_rcs_ua_hwservice, hwservice_manager_type;

binder_call(volte_rcs_ua, system_app)

get_prop(volte_rcs_ua, hwservicemanager_prop)

hal_server_domain(volte_rcs_ua, hal_rcs)

hwbinder_use(volte_rcs_ua)

init_daemon_domain(volte_rcs_ua)

set_prop(volte_rcs_ua, vendor_mtk_service_rcs_prop)

allow volte_rcs_ua debugfs_tracing:file { open write };
allow volte_rcs_ua rcs_rild_socket:sock_file { append getattr open read write };
allow volte_rcs_ua rcs_volte_stack:unix_stream_socket { connectto getattr read };
allow volte_rcs_ua rcs_volte_stack_socket:sock_file { append getattr open read write };
allow volte_rcs_ua rild:unix_stream_socket { connectto getattr read };
