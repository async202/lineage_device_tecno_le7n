type mtk_hal_keyinstall, domain;
type mtk_hal_keyinstall_exec, exec_type, file_type, vendor_file_type;
type mtk_hal_keyinstall_hwservice, hwservice_manager_type;

hal_server_domain(mtk_hal_keyinstall, hal_keymaster)

init_daemon_domain(mtk_hal_keyinstall)

allow mtk_hal_keyinstall debugfs_tracing:file write;
allow mtk_hal_keyinstall key_install_data_file:dir { add_name remove_name search write };
allow mtk_hal_keyinstall key_install_data_file:file { append create getattr open read setattr unlink write };
allow mtk_hal_keyinstall mobicore:unix_stream_socket connectto;
allow mtk_hal_keyinstall mobicore_data_file:dir search;
allow mtk_hal_keyinstall mobicore_data_file:file { getattr open read };
allow mtk_hal_keyinstall mobicore_user_device:chr_file { ioctl open read write };
allow mtk_hal_keyinstall persist_data_file:dir { add_name search write };
allow mtk_hal_keyinstall persist_data_file:file { create getattr open read setattr write };
